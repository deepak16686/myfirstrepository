# =============================================================================
# .gitignore - DevOps platform repo
# =============================================================================
# Secrets scanning: git secrets / gitleaks / trufflehog run in pre-commit.
# See .env.example for the list of expected env vars.
# Also see devops-tools-backend/docs/SECRET_ROTATION.md.
# =============================================================================

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/

# ---- IDE ------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
nul

# ---- Project caches / artifacts -------------------------------------------
chromadb-data/
*.log
files.zip
Screenshots/

# ---- Environment files ----------------------------------------------------
# Never commit actual env files. ONLY .env.example is tracked.
.env
.env.*
!.env.example
!.env.sample

# ---- Secret / credential material -----------------------------------------
*credentials*.txt
*password*.txt
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
**/credentials
**/credentials.json
**/serviceAccount*.json
**/.vault-token
**/secrets.yaml
**/secrets.yml
# K8s Secret templates are OK if they contain only <REPLACE_ME> placeholders:
!**/_secrets-template.yaml
!**/_secrets-template.yml

# ---- Terraform / IaC state ------------------------------------------------
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---- Claude Code / editor session state -----------------------------------
# Local session permissions + history may contain command-line secrets;
# do not track them.
.claude/settings.local.json
.claude/settings.json
.claude/sessions/
.claude/.history/

# ---- Open WebUI function backups (may contain embedded PATs) --------------
**/openwebui_functions/*.py.bak*
**/openwebui_functions/*.backup*

# ---- Build artifacts ------------------------------------------------------
dist/
build/
*.egg-info/

# ---- Docker ---------------------------------------------------------------
docker-compose.override.yml

# ---- Temp / backup --------------------------------------------------------
*.tmp
*.bak
*.bak-*
*.backup-*
# Session-specific timestamp backups made during edits:
*.bak-????????-??????
.gitlab-root-creds.local
.remember/
*.stackdump
