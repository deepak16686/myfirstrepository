# =============================================================================
# DevOps Platform - Environment Example
# =============================================================================
# Copy to .env (never commit .env) and fill in values from Vault or 1Password.
# Every variable here is REQUIRED by at least one component in this repo.
# Consumers use fail-fast semantics:
#   - Python:       os.environ["VAR"]            raises KeyError if missing
#   - Compose/YAML: ${VAR:?VAR is required}      aborts compose with clear msg
#   - PowerShell:   $env:VAR ?? (throw 'VAR ...')
#   - Kubernetes:   stringData: <REPLACE_ME>     (managed out-of-band)
#
# Secrets live in Vault under secret/devops/<tool>. See SECRET_ROTATION.md.
# =============================================================================

# ---------------------------------------------------------------------------
# GitLab (CE or self-hosted)
# ---------------------------------------------------------------------------
GITLAB_URL=                       # e.g. http://localhost:8929 or https://gitlab.example.com
GITLAB_EXTERNAL_URL=              # external URL used by GitLab for clone/push URLs
GITLAB_HTTP_PORT=8929             # host port for web UI
GITLAB_SSH_PORT=2222              # host port for SSH git
GITLAB_ROOT_PASSWORD=             # root user initial password - rotate after first login
GITLAB_TOKEN=                     # Personal Access Token (glpat-...) - scope: api, read_repository, write_repository
GITLAB_PAT=                       # Alias sometimes used; set to same value as GITLAB_TOKEN
GITLAB_USER_NAME=                 # Commit author name (e.g. "DevOps Bot")
GITLAB_USER_EMAIL=                # Commit author email (e.g. devops-bot@example.com)

# ---------------------------------------------------------------------------
# Nexus Repository Manager (Docker + raw + maven)
# ---------------------------------------------------------------------------
NEXUS_URL=                        # e.g. http://localhost:8081
NEXUS_UI_PORT=8081
NEXUS_REGISTRY=                   # docker registry host:port, e.g. localhost:5001
NEXUS_REGISTRY_PORT=5001
NEXUS_DOCKER_HOST=                # internal compose host, e.g. nexus
NEXUS_DOCKER_PORT=5001
NEXUS_INTERNAL_REGISTRY=          # e.g. nexus:5001 (compose-network DNS name)
NEXUS_PULL_REGISTRY=              # public mirror for cache, e.g. nexus-proxy:5002
NEXUS_REPO=                       # default repo name, e.g. docker-private
NEXUS_REPO_PATH=                  # path prefix inside the repo (optional)
NEXUS_USERNAME=                   # e.g. admin
NEXUS_PASSWORD=                   # rotate via Nexus admin UI; store in Vault

# ---------------------------------------------------------------------------
# SonarQube (Community / Developer Edition)
# ---------------------------------------------------------------------------
SONARQUBE_URL=                    # e.g. http://localhost:9000
SONARQUBE_HOST=                   # compose-network DNS, e.g. sonarqube
SONARQUBE_PORT=9000
SONARQUBE_USERNAME=               # admin
SONARQUBE_PASSWORD=               # global admin password - rotate via UI
SONARQUBE_DB_USER=                # Postgres user for Sonar DB
SONARQUBE_DB_PASSWORD=            # Postgres password for Sonar DB
SONARQUBE_DB_NAME=                # e.g. sonar
SONAR_TOKEN=                      # Global or user analysis token (squ_/sqa_)

# SonarQube per-project analysis tokens (legacy migration projects)
# Generate with: POST /api/user_tokens/generate (admin or project-scoped)
SONAR_TOKEN_LEGACY_ASSET_MANAGEMENT=
SONAR_TOKEN_LEGACY_AUTHENTICATION_SERVICE=
SONAR_TOKEN_LEGACY_BANKING_CORE=
SONAR_TOKEN_LEGACY_CRM_SYSTEM=
SONAR_TOKEN_LEGACY_DATA_WAREHOUSE=
SONAR_TOKEN_LEGACY_DOCUMENT_ARCHIVE=
SONAR_TOKEN_LEGACY_EMAIL_GATEWAY=
SONAR_TOKEN_LEGACY_ERP_FINANCE=
SONAR_TOKEN_LEGACY_FLIGHT_RESERVATION=
SONAR_TOKEN_LEGACY_HEALTHCARE_RECORDS=
SONAR_TOKEN_LEGACY_HOTEL_BOOKING=
SONAR_TOKEN_LEGACY_HR_PAYROLL=
SONAR_TOKEN_LEGACY_INSURANCE_POLICY=
SONAR_TOKEN_LEGACY_INVENTORY_MANAGER=
SONAR_TOKEN_LEGACY_LOGISTICS_TRACKER=
SONAR_TOKEN_LEGACY_MANUFACTURING_MES=
SONAR_TOKEN_LEGACY_REPORTING_ENGINE=
SONAR_TOKEN_LEGACY_RETAIL_POS=
SONAR_TOKEN_LEGACY_SUPPLY_CHAIN=
SONAR_TOKEN_LEGACY_TELECOM_BILLING=

# ---------------------------------------------------------------------------
# Splunk (HEC + admin)
# ---------------------------------------------------------------------------
SPLUNK_HEC_URL=                   # e.g. http://localhost:8088
SPLUNK_HEC_TOKEN=                 # Splunk HEC token (HTTP Event Collector)
SPLUNK_PASSWORD=                  # Splunk admin password - rotate via UI

# ---------------------------------------------------------------------------
# Jira / Redmine (project tracking)
# ---------------------------------------------------------------------------
REDMINE_PORT=3001
REDMINE_ADMIN_PASSWORD=           # admin user password - rotate after install
REDMINE_API_KEY=                  # REST API key from Redmine profile -> API access key
REDMINE_SECRET_KEY_BASE=          # Rails app secret key base (random 64+ chars)
REDMINE_DB_USERNAME=              # Postgres user for Redmine DB
REDMINE_DB_USER=                  # Alias of REDMINE_DB_USERNAME (some compose files)
REDMINE_DB_PASSWORD=              # Postgres password for Redmine DB
REDMINE_DB_NAME=                  # e.g. redmine

# ---------------------------------------------------------------------------
# Postgres (AI / modernization workloads)
# ---------------------------------------------------------------------------
POSTGRES_AI_HOST=                 # e.g. postgres-ai
POSTGRES_AI_PORT=5432
POSTGRES_AI_USER=                 # e.g. modernization
POSTGRES_AI_PASSWORD=             # Postgres password - rotate via ALTER USER
POSTGRES_AI_DB=                   # e.g. legacy_modernization

# Generic Postgres (used by Sonar, Redmine, Plane, etc.)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# pgAdmin UI
PGADMIN_DEFAULT_EMAIL=            # e.g. devops@example.com
PGADMIN_DEFAULT_PASSWORD=         # pgAdmin login password

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object store)
# ---------------------------------------------------------------------------
MINIO_HOST=                       # compose-network DNS, e.g. minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=                  # e.g. minioadmin (change before prod)
MINIO_ROOT_PASSWORD=              # MinIO root password - rotate via mc admin

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=           # Grafana admin password - rotate via UI or grafana-cli

# ---------------------------------------------------------------------------
# Prometheus / Loki / Jaeger / Trivy
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_PORT=3100
JAEGER_UI_PORT=16686
TRIVY_PORT=8083
TRIVY_URL=                        # e.g. http://trivy:4954
TRIVY_SERVER_URL=                 # alias for TRIVY_URL

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=                       # e.g. redis
REDIS_PORT=6379
REDIS_URL=                        # e.g. redis://redis:6379/0
# If Redis is password-protected, set REDIS_PASSWORD and include in REDIS_URL.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# ChromaDB (vector store)
# ---------------------------------------------------------------------------
CHROMADB_URL=                     # e.g. http://chromadb:8000
CHROMADB_HOST=                    # compose-network DNS
CHROMADB_PORT=8000
CHROMA_PORT=8005                  # host-side port, if differing

# ---------------------------------------------------------------------------
# Ollama (local LLM)
# ---------------------------------------------------------------------------
OLLAMA_URL=                       # e.g. http://ollama:11434
OLLAMA_HOST=
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Vault (HashiCorp)
# ---------------------------------------------------------------------------
VAULT_ADDR=                       # e.g. https://vault.example.com:8200
VAULT_TOKEN=                      # short-lived app/approle token - NEVER the root token
VAULT_NAMESPACE=                  # enterprise only (optional)
VAULT_ROLE_ID=                    # AppRole auth
VAULT_SECRET_ID=                  # AppRole auth

# ---------------------------------------------------------------------------
# Tailscale (Funnel / Serve)
# ---------------------------------------------------------------------------
TAILSCALE_AUTHKEY=                # tskey-auth-... (scope: reusable, ephemeral, tags)
TAILSCALE_HOSTNAME=               # e.g. devops-portal
TAILSCALE_FUNNEL_PORT=443

# ---------------------------------------------------------------------------
# Docker Registry (fallbacks)
# ---------------------------------------------------------------------------
DOCKER_REGISTRY=                  # e.g. nexus:5001
BASE_REGISTRY=                    # for pulling base images
REGISTRY_HOST=
REGISTRY_PORT=
REGISTRY_URL=

# ---------------------------------------------------------------------------
# GitHub (for mirror / sync jobs)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=                     # PAT with repo scope

# ---------------------------------------------------------------------------
# DevOps Tools Backend (this repo's FastAPI service)
# ---------------------------------------------------------------------------
DEVOPS_BACKEND_URL=               # e.g. http://host.docker.internal:8003
APP_NAME=devops-tools-backend
APP_VERSION=1.0.0
DEBUG=false

# ---------------------------------------------------------------------------
# Kubernetes (for Harness / kubectl / helm jobs)
# ---------------------------------------------------------------------------
KUBECONFIG=                       # path to kubeconfig; prefer in-cluster SA in pods
NAMESPACE=                        # target namespace for deploys
