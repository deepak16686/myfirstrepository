# =============================================================================
# route53.env — AWS credentials for certbot DNS-01 via Route 53 (fallback).
# -----------------------------------------------------------------------------
# Use ONLY if the registrar/DNS provider is Route53. Create a dedicated IAM
# user with an inline policy limited to the hosted zone of deepaksharma.live.
# Minimum policy (substitute YOUR_HOSTED_ZONE_ID; find it in the AWS console
# under Route 53 > Hosted zones):
#
#   {
#     "Version": "2012-10-17",
#     "Statement": [
#       {
#         "Effect": "Allow",
#         "Action": ["route53:ListHostedZones", "route53:GetChange"],
#         "Resource": ["*"]
#       },
#       {
#         "Effect": "Allow",
#         "Action": ["route53:ChangeResourceRecordSets"],
#         "Resource": ["arn:aws:route53:::hostedzone/YOUR_HOSTED_ZONE_ID"]
#       }
#     ]
#   }
#
# Reference: https://certbot-dns-route53.readthedocs.io/en/stable/#credentials
#
# Create IAM access key:  https://console.aws.amazon.com/iam/home#/users
#   Security credentials -> Access keys -> Create access key -> Other (CLI)
#
# Store secret separately in a password manager; never commit.  After pasting:
#   chmod 600 certbot/secrets/route53.env
# =============================================================================

AWS_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
