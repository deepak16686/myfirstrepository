# DevOps Tools Backend Configuration

# GitLab
GITLAB_URL=http://localhost:8929
GITLAB_TOKEN=your-gitlab-token

# SonarQube
SONARQUBE_URL=http://localhost:9002
SONARQUBE_USERNAME=admin
SONARQUBE_PASSWORD=your-sonarqube-password

# Trivy
TRIVY_URL=http://localhost:8083

# Nexus
NEXUS_URL=http://localhost:8081
NEXUS_USERNAME=admin
NEXUS_PASSWORD=your-nexus-password

# ChromaDB
CHROMADB_URL=http://localhost:8000

# Ollama
OLLAMA_URL=http://localhost:11434

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (AI / modernization workloads)
POSTGRES_AI_USER=
POSTGRES_AI_PASSWORD=
POSTGRES_AI_HOST=localhost
POSTGRES_AI_PORT=5432
POSTGRES_AI_DB=
POSTGRES_URL=postgresql://${POSTGRES_AI_USER}:${POSTGRES_AI_PASSWORD}@${POSTGRES_AI_HOST}:${POSTGRES_AI_PORT}/${POSTGRES_AI_DB}

# Debug
DEBUG=false
